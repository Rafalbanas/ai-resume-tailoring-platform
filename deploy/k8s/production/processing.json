{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "cvtailor-processing-owner",
        "namespace": "cvtailor-prod"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "cvtailor-processing-owner"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "cvtailor-processing-owner",
              "role": "cvtailor-processing"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001
            },
            "containers": [
              {
                "name": "processor",
                "image": "ghcr.io/rafalbanas/ai-resume-tailoring-platform:PROCESSING_IMAGE_REQUIRED",
                "command": [
                  "uvicorn",
                  "app.processing_server:app",
                  "--host",
                  "0.0.0.0",
                  "--port",
                  "8080",
                  "--no-access-log",
                  "--limit-concurrency",
                  "8"
                ],
                "env": [
                  {
                    "name": "PROCESSING_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cvtailor-processing",
                        "key": "owner"
                      }
                    }
                  },
                  {
                    "name": "HOME",
                    "value": "/tmp"
                  },
                  {
                    "name": "PYTHONUNBUFFERED",
                    "value": "1"
                  },
                  {
                    "name": "PYTHONDONTWRITEBYTECODE",
                    "value": "1"
                  },
                  {
                    "name": "PROCESSING_CONTAINER_ISOLATED",
                    "value": "1"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "scratch",
                    "mountPath": "/tmp"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "scratch",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              }
            ],
            "imagePullSecrets": [
              {
                "name": "cvtailor-ghcr"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "cvtailor-processing-owner",
        "namespace": "cvtailor-prod"
      },
      "spec": {
        "selector": {
          "app": "cvtailor-processing-owner"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "cvtailor-processing-owner",
        "namespace": "cvtailor-prod"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "cvtailor-processing-owner"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "cvtailor"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "UDP",
                "port": 53
              },
              {
                "protocol": "TCP",
                "port": 53
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "0.0.0.0/0",
                  "except": [
                    "0.0.0.0/8",
                    "10.0.0.0/8",
                    "100.64.0.0/10",
                    "127.0.0.0/8",
                    "169.254.0.0/16",
                    "172.16.0.0/12",
                    "192.0.0.0/24",
                    "192.168.0.0/16",
                    "198.18.0.0/15",
                    "224.0.0.0/4",
                    "240.0.0.0/4",
                    "192.0.2.0/24",
                    "198.51.100.0/24",
                    "203.0.113.0/24"
                  ]
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 80
              },
              {
                "protocol": "TCP",
                "port": 443
              }
            ]
          }
        ]
      }
    },
