N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Used only for first-run migration when data/auth.json does not exist.
APP_USERNAME=
APP_PASSWORD=
CSRF_SECRET=
BASE_URL=https://cv.example.com
# Optional second account using the same /login and an isolated existing data directory.
# DEMO_DATA_DIR=/app/demo-data
# DEMO_CSRF_SECRET_FILE=/run/cvtailor-demo/csrf-secret
APP_BUILD_SHA=development
APP_BUILD_TIMESTAMP=unknown
DATA_DIR=/app/data
# LLM Provider selection: ollama, gemini, mock, auto
# Default provider remains ollama until side-by-side comparison.
AI_PROVIDER=ollama
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=gemini
PROFILE_MODE=production

# Ollama Configuration (Local / Remote via SSH Tunnel)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONNECT_TIMEOUT_SECONDS=10.0
OLLAMA_READ_TIMEOUT_SECONDS=300.0
OLLAMA_TIMEOUT_SECONDS=300.0
OLLAMA_KEEP_ALIVE=15m
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_NUM_PREDICT=8192
OLLAMA_NUM_CTX=32768
# Targeted analysis repair calls before fallback; shared operation timeout still applies.
OLLAMA_ANALYSIS_RECOVERY_CALLS=4

# Google Gemini API Configuration (Free Tier via Google AI Studio)
# Obtain an API key at https://aistudio.google.com/
# Leave empty if using Ollama exclusively. Never commit actual keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_CONNECT_TIMEOUT_SECONDS=15.0
GEMINI_READ_TIMEOUT_SECONDS=60.0
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=0

# Total operation budget covering analysis, resume tailoring, and fallback attempts combined
LLM_OPERATION_BUDGET_SECONDS=900.0
REFERENCE_CV_MAX_BYTES=10000000
PROFILE_PHOTO_MAX_BYTES=5000000
REQUEST_TIMEOUT_SECONDS=60
MAX_JOB_DESCRIPTION_CHARS=30000
RATE_LIMIT_PER_MINUTE=20
JOB_FETCH_TIMEOUT_SECONDS=12
JOB_FETCH_MAX_BYTES=2000000
JOB_FETCH_MAX_REDIRECTS=3
JOB_FETCH_PLAYWRIGHT_ENABLED=true
CV_TAILOR_PORT=8000

# Isolated processing services (Docker Compose sets loopback URLs automatically).
# Generate independent random tokens, for example: openssl rand -hex 32
PROCESSING_TOKEN=
DEMO_PROCESSING_TOKEN=
# Opt-in: keep only the latest 100 analysis tasks and remove their unsaved drafts.
# Generated CV history is never automatically deleted.
AUTO_DELETE_HISTORY=false
MAX_PENDING_TASKS=4
AI_DAILY_CALL_LIMIT=300
DEMO_AI_DAILY_CALL_LIMIT=60
STORAGE_QUOTA_BYTES=536870912
DEMO_STORAGE_QUOTA_BYTES=134217728
