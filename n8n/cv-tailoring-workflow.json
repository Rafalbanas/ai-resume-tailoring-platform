    {
      "parameters": {
        "promptType": "define",
        "text": "=Create the strongest ATS-friendly resume selection for this job using ONLY master_profile. Output data, never HTML. Every summary sentence must cite summary_source_fact_ids such as summary:0. Every experience bullet must cite source_fact_ids like experience:0:fact:1. Every project must cite project:0:description or project:0:fact:0. Use only exact company/title/project/certification names and exact skills from the profile. If a fact has no source ID, omit it. Keep summary to at most 4 short source facts, at most 4 bullets per role, 18 skills, and 2 projects. The Python validator will discard unsupported content.\n\nJOB:\n{{ JSON.stringify($('Webhook').item.json.body.job) }}\n\nANALYSIS:\n{{ JSON.stringify($json.output) }}\n\nMASTER PROFILE:\n{{ JSON.stringify($('Webhook').item.json.body.master_profile) }}",
        "hasOutputParser": true,
        "options": {"systemMessage": "You select and organize verified candidate facts. You must not create, infer, quantify, or embellish any fact."}
      },
